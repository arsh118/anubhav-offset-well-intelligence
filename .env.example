# Copy to .env for a local PostgreSQL run. Docker Compose overrides the host to `db`.
POSTGRES_DB=anubhav
POSTGRES_USER=anubhav
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://anubhav:change-me-local-only@localhost:5432/anubhav
API_HOST=0.0.0.0
API_PORT=8000
UPLOAD_DIR=./data/uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Offset score defaults are heuristic prototype values, not an OIL-approved formula.
OFFSET_DEFAULT_RADIUS_KM=10.0
OFFSET_DEFAULT_DEPTH_WINDOW_M=100.0
OFFSET_DEPTH_HIGH_MAX_M=25.0
OFFSET_DEPTH_MEDIUM_MAX_M=50.0
OFFSET_DEPTH_LOW_MAX_M=100.0
OFFSET_FORMATION_WEIGHT=0.30
OFFSET_DEPTH_WEIGHT=0.25
OFFSET_SPATIAL_WEIGHT=0.20
OFFSET_EVENT_WEIGHT=0.15
OFFSET_SOURCE_CONFIDENCE_WEIGHT=0.10
OFFSET_FORMATION_ALIAS_SCORE=0.85
OFFSET_RELATED_EVENT_SCORE=0.50
OFFSET_HIGH_RELEVANCE_MIN_SCORE=0.75
OFFSET_MEDIUM_RELEVANCE_MIN_SCORE=0.50
